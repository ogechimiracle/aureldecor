# ----------------------------------------------------------------------
# Aurelia Interiors portfolio — environment variables
# Copy this file to `.env.local` and fill in real values.
# Never commit real secrets. (`.env*.local` is git-ignored by default.)
# ----------------------------------------------------------------------

# Public site URL. MUST match your production domain (no trailing slash).
# Used for canonical URLs, sitemap, robots and social sharing.
# On Vercel you can set this to your domain, e.g. https://aurelia-interiors.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Owner sessions -----------------------------------------------------
# REQUIRED in production. Seals the admin session cookie; must be at least
# 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In development a temporary random secret is used if this is omitted, so
# sessions reset whenever the dev server restarts.
SESSION_SECRET=

# --- Storage (optional) --------------------------------------------------
# Absolute or relative paths. Defaults: data/app.db and data/uploads
# DATABASE_FILE=data/app.db
# MEDIA_DIR=data/uploads

# --- Production database (Turso) -----------------------------------------
# Required on Vercel. Create a Turso database and set both values in the
# Vercel project environment. Leave unset for local SQLite development.
# TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
# TURSO_AUTH_TOKEN=

# --- Upload limits (optional) -------------------------------------------
# MAX_IMAGE_UPLOAD_MB=15
# MAX_VIDEO_UPLOAD_MB=250

# --- Email delivery (Resend) --------------------------------------------
# Get an API key from https://resend.com
# The "from" address must be a verified domain in Resend.
# The "to" address receives contact-form enquiries (the studio inbox).
RESEND_API_KEY=
CONTACT_FROM_EMAIL=studio@yourdomain.com
CONTACT_TO_EMAIL=studio@yourdomain.com